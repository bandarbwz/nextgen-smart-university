{
    "name": "nextgen/smart-university-backend",
    "description": "NextGen Smart University Platform - REST API Backend",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-json": "*",
        "firebase/php-jwt": "^7.0",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "test:security": "phpunit --testsuite Security"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    }
}
